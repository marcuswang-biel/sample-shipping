{
	"expo": {
		"name": "樣品寄送",
		"slug": "shipping",
		"version": "0.1.0",
		"scheme": "shipping",
		"orientation": "portrait",
		"userInterfaceStyle": "automatic",
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.shipping.app"
		},
		"android": {
			"package": "com.shipping.app"
		},
		"plugins": ["expo-router", "expo-secure-store", "expo-web-browser"],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
